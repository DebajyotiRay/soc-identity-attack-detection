<group name="identity_lab,">
  <rule id="100001" level="5">
    <decoded_as>identity-lab-login</decoded_as>
    <description>Identity Lab: login attempt detected</description>
  </rule>

  <rule id="100002" level="7">
    <decoded_as>identity-lab-rolechange</decoded_as>
    <description>Identity Lab: role change detected</description>
  </rule>

  <rule id="100003" level="8">
    <decoded_as>identity-lab-mfa</decoded_as>
    <description>Identity Lab: MFA reset/registration event detected</description>
  </rule>

  <rule id="100004" level="3">
    <if_sid>100001</if_sid>
    <field name="result">FAILURE</field>
    <description>Identity Lab: failed login attempt</description>
  </rule>

  <rule id="100005" level="10" frequency="3" timeframe="120">
    <if_matched_sid>100004</if_matched_sid>
    <same_source_ip />
    <different_srcuser />
    <description>Identity Lab: Possible password spray attack - multiple failed logins across different users from same source IP</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>

  <rule id="100006" level="9">
    <if_sid>100001</if_sid>
    <field name="result">SUCCESS</field>
    <list field="srcip" lookup="not_match_key">etc/lists/known_ips.txt</list>
    <description>Identity Lab: Successful login from unrecognized/untrusted IP address</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100007" level="12">
    <if_sid>100003</if_sid>
    <field name="result">SUCCESS</field>
    <list field="srcip" lookup="not_match_key">etc/lists/known_ips.txt</list>
    <description>Identity Lab: MFA reset from untrusted IP - possible account takeover in progress</description>
    <mitre>
      <id>T1556</id>
    </mitre>
  </rule>

  <rule id="100008" level="13">
    <if_sid>100002</if_sid>
    <field name="new_role">admin</field>
    <field name="result">SUCCESS</field>
    <time>18:00-09:00</time>
    <description>Identity Lab: Privilege escalation to admin outside business hours</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
  </rule>

  <rule id="100009" level="13">
    <if_sid>100002</if_sid>
    <user>svc_backup</user>
    <description>Identity Lab: Service account performed a role change - highly anomalous, possible compromise</description>
    <mitre>
      <id>T1078.001</id>
    </mitre>
  </rule>
</group>